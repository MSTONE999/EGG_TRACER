local function createEffect(egg)

	local settings =
		eggSettings[egg.Name]

	if not settings then
		return
	end

	local part =
		getEggPart(egg)

	if not part then
		return
	end

	--------------------------------------------------
	-- HIGHLIGHT
	--------------------------------------------------

	local highlight =
		Instance.new("Highlight")

	highlight.Name =
		"EggHighlight"

	highlight.Adornee =
		egg

	highlight.FillColor =
		settings.secondary

	highlight.OutlineColor =
		settings.color

	highlight.FillTransparency =
		0.30

	highlight.OutlineTransparency =
		0

	highlight.DepthMode =
		Enum.HighlightDepthMode.AlwaysOnTop

	highlight.Parent =
		effectFolder

	--------------------------------------------------
	-- TEXT
	--------------------------------------------------

	local billboard =
		createBillboard(
			egg,
			part,
			settings
		)

	--------------------------------------------------
	-- SAVE
	--------------------------------------------------

	table.insert(
		eggs,
		{
			object = egg,
			part = part,
			highlight = highlight,
			billboard = billboard
		}
	)
end

