--------------------------------------------------
-- FIND PLAYER PLOT
--------------------------------------------------

local function findPlayerPlot()

	local plots =
		workspace:FindFirstChild(
			"Plots"
		)

	if not plots then

		warn(
			"workspace.Plots not found!"
		)

		return nil
	end

	for _, plot in ipairs(
		plots:GetChildren()
	) do

		if plot:IsA("Model")
			and plot.Name == "Plot" then

			local data =
				plot:FindFirstChild(
					"Data"
				)

			if data then

				local owner =
					data:FindFirstChild(
						"Owner"
					)

				if owner
					and owner:IsA(
						"ObjectValue"
					) then

					local ownerValue =
						owner.Value

					if ownerValue then

						if ownerValue == player
							or ownerValue.Name ==
								player.Name then

							return plot

						end
					end
				end
			end
		end
	end

	return nil
end

--------------------------------------------------
-- GET PLOT PART
--------------------------------------------------

local function getPlotPart(plot)

	if not plot then
		return nil
	end

	--------------------------------------------------
	-- PRIMARY PART
	--------------------------------------------------

	if plot:IsA("Model")
		and plot.PrimaryPart then

		return plot.PrimaryPart
	end

	--------------------------------------------------
	-- COMMON PART NAMES
	--------------------------------------------------

	local names = {

		"Spawn",
		"SpawnLocation",
		"PlotSpawn",
		"Teleport",
		"Center",
		"Base"

	}

	for _, name in ipairs(names) do

		local object =
			plot:FindFirstChild(
				name,
				true
			)

		if object
			and object:IsA(
				"BasePart"
			) then

			return object

		end
	end

	--------------------------------------------------
	-- FALLBACK
	--------------------------------------------------

	return plot:FindFirstChildWhichIsA(
		"BasePart",
		true
	)
end

--------------------------------------------------
-- TELEPORT
--------------------------------------------------

local function teleportToPart(
	part,
	offset
)

	local root =
		getRoot()

	if not root
		or not part then

		return false
	end

	root.CFrame =
		part.CFrame
		* CFrame.new(
			0,
			offset or 3,
			0
		)

	return true
end

--------------------------------------------------
-- ROTATE CAMERA UNTIL PROMPT
--------------------------------------------------

local function rotateCameraUntilPrompt(
	egg,
	prompt
)

	local camera =
		workspace.CurrentCamera

	local part =
		getEggPart(egg)

	if not camera
		or not part then

		return false
	end

	--------------------------------------------------
	-- ALREADY ENABLED
	--------------------------------------------------

	if prompt
		and prompt.Parent
		and prompt.Enabled then

		return true
	end

	--------------------------------------------------
	-- ROTATE AROUND EGG
	--------------------------------------------------

	local center =
		part.Position

	for angle = 0, 360, 30 do

		if not prompt
			or not prompt.Parent then

			return false
		end

		local radians =
			math.rad(angle)

		local distance =
			8

		local cameraPosition =
			center
			+ Vector3.new(
				math.cos(radians)
					* distance,

				4,

				math.sin(radians)
					* distance
			)

		camera.CFrame =
			CFrame.lookAt(
				cameraPosition,
				center
			)

		RunService.RenderStepped:Wait()

		if prompt.Enabled then

			return true

		end
	end

	return false
end

--------------------------------------------------
-- INTERACT WITH PROMPT
--------------------------------------------------

local function interactPrompt(prompt)

	if not prompt then
		return false
	end

	if not prompt.Enabled then
		return false
	end

	--------------------------------------------------
	-- FIREPROXIMITYPROMPT
	--------------------------------------------------

	if typeof(
		fireproximityprompt
	) == "function" then

		fireproximityprompt(
			prompt
		)

		return true
	end

	--------------------------------------------------
	-- FALLBACK
	--------------------------------------------------

	local success =
		pcall(
			function()

				prompt:InputHoldBegin()

			end
		)

	if not success then
		return false
	end

	task.wait(
		prompt.HoldDuration
	)

	pcall(
		function()

			prompt:InputHoldEnd()

		end
	)

	return true
end

--------------------------------------------------
-- COLLECT ONE EGG UNTIL IT IS GONE
--------------------------------------------------

local function collectEggUntilGone(data)

	if not data then
		return
	end

	local egg =
		data.object

	--------------------------------------------------
	-- KEEP REPEATING WHILE SAME EGG EXISTS
	--------------------------------------------------

	while AUTO_COLLECT
		and eggStillExists(egg) do

		--------------------------------------------------
		-- GET CURRENT PART
		--------------------------------------------------

		local part =
			getEggPart(egg)

		if not part then
			break
		end

		--------------------------------------------------
		-- GET CURRENT PROMPT
		--------------------------------------------------

		local prompt =
			findPrompt(egg)

		if not prompt then

			status.Text =
				"● No prompt: "
				.. egg.Name

			status.TextColor3 =
				Color3.fromRGB(
					255,
					100,
					100
				)

			task.wait(
				0.5
			)

			continue
		end

		--------------------------------------------------
		-- FIND PLOT BEFORE LEAVING
		--------------------------------------------------

		local playerPlot =
			findPlayerPlot()

		--------------------------------------------------
		-- TELEPORT TO EGG
		--------------------------------------------------

		status.Text =
			"● Going to "
			.. egg.Name

		status.TextColor3 =
			Color3.fromRGB(
				255,
				190,
				45
			)

		teleportToPart(
			part,
			TELEPORT_DISTANCE
		)

		task.wait(
			0.2
		)

		--------------------------------------------------
		-- CHECK PROMPT
		--------------------------------------------------

		if not prompt.Parent then
			continue
		end

		--------------------------------------------------
		-- CAMERA ROTATION IF NEEDED
		--------------------------------------------------

		if not prompt.Enabled then

			rotateCameraUntilPrompt(
				egg,
				prompt
			)

		end

		--------------------------------------------------
		-- INTERACT
		--------------------------------------------------

		if prompt.Parent
			and prompt.Enabled then

			status.Text =
				"● Interacting..."

			status.TextColor3 =
				Color3.fromRGB(
					100,
					255,
					150
				)

			interactPrompt(
				prompt
			)

			--------------------------------------------------
			-- LET GAME PROCESS IT
			--------------------------------------------------

			task.wait(
				0.7
			)

		else

			task.wait(
				0.5
			)

			continue
		end

		--------------------------------------------------
		-- RETURN TO PLAYER PLOT
		--------------------------------------------------

		if playerPlot
			and playerPlot.Parent then

			local plotPart =
				getPlotPart(
					playerPlot
				)

			if plotPart then

				status.Text =
					"● Returning to plot"

				status.TextColor3 =
					Color3.fromRGB(
						190,
						80,
						255
					)

				teleportToPart(
					plotPart,
					4
				)

				task.wait(
					0.5
				)
			end
		end

		--------------------------------------------------
		-- CHECK SAME EGG AGAIN
		--------------------------------------------------

		if eggStillExists(egg) then

			status.Text =
				"● Still there → retrying"

			status.TextColor3 =
				Color3.fromRGB(
					255,
					190,
					45
				)

			task.wait(
				0.3
			)

			--------------------------------------------------
			-- LOOP STARTS AGAIN
			--------------------------------------------------

		else

			status.Text =
				"● Egg collected!"

			status.TextColor3 =
				Color3.fromRGB(
					100,
					255,
					150
				)

			break
		end
	end
end

--------------------------------------------------
-- COLLECT ALL EGGS
--------------------------------------------------

local function collectEggs()

	if currentlyCollecting then
		return
	end

	currentlyCollecting =
		true

	--------------------------------------------------
	-- REFRESH EGG LIST
	--------------------------------------------------

	scanEggs()

	--------------------------------------------------
	-- COPY CURRENT TARGETS
	--------------------------------------------------

	local targets = {}

	for _, data in ipairs(
		eggs
	) do

		if eggStillExists(
			data.object
		) then

			table.insert(
				targets,
				data
			)

		end
	end

	--------------------------------------------------
	-- PROCESS EACH TARGET
	--------------------------------------------------

	for _, data in ipairs(
		targets
	) do

		if not AUTO_COLLECT then
			break
		end

		if eggStillExists(
			data.object
		) then

			collectEggUntilGone(
				data
			)

		end

		task.wait(
			0.3
		)
	end

	--------------------------------------------------
	-- FINAL REFRESH
	--------------------------------------------------

	scanEggs()

	status.Text =
		AUTO_COLLECT
		and "● AUTO ON"
		or "● OFF"

	status.TextColor3 =
		AUTO_COLLECT
		and Color3.fromRGB(
			190,
			80,
			255
		)
		or Color3.fromRGB(
			130,
			130,
			140
		)

	currentlyCollecting =
		false
end

--------------------------------------------------
-- TOGGLE
--------------------------------------------------

local function setEnabled(state)

	AUTO_COLLECT =
		state

	--------------------------------------------------
	-- KEEP HIGHLIGHTS + TEXT ON
	--------------------------------------------------

	for _, data in ipairs(
		eggs
	) do

		if data.highlight then

			data.highlight.Enabled =
				true

		end

		if data.billboard then

			data.billboard.Enabled =
				true

		end
	end

	--------------------------------------------------
	-- SWITCH COLOR
	--------------------------------------------------

	TweenService:Create(

		toggle,

		TweenInfo.new(
			0.22,
			Enum.EasingStyle.Quart,
			Enum.EasingDirection.Out
		),

		{
			BackgroundColor3 =
				state
				and Color3.fromRGB(
					150,
					45,
					255
				)
				or Color3.fromRGB(
					60,
					60,
					70
				)
		}

	):Play()

	--------------------------------------------------
	-- KNOB
	--------------------------------------------------

	TweenService:Create(

		knob,

		TweenInfo.new(
			0.25,
			Enum.EasingStyle.Back,
			Enum.EasingDirection.Out
		),

		{
			Position =
				state
				and UDim2.fromOffset(
					23,
					3
				)
				or UDim2.fromOffset(
					3,
					3
				)
		}

	):Play()

	--------------------------------------------------
	-- BORDER
	--------------------------------------------------

	TweenService:Create(

		mainStroke,

		TweenInfo.new(
			0.22
		),

		{
			Color =
				state
				and Color3.fromRGB(
					190,
					70,
					255
				)
				or Color3.fromRGB(
					75,
					75,
					90
				)
		}

	):Play()

	--------------------------------------------------
	-- STATUS
	--------------------------------------------------

	status.Text =
		state
		and "● AUTO ON"
		or "● OFF"

	status.TextColor3 =
		state
		and Color3.fromRGB(
			190,
			80,
			255
		)
		or Color3.fromRGB(
			130,
			130,
			140
		)

	--------------------------------------------------
	-- START
	--------------------------------------------------

	if state then

		task.spawn(
			collectEggs
		)

	end
end

