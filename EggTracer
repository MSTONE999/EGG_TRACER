--------------------------------------------------
-- GET EGG PART
--------------------------------------------------

local function getEggPart(egg)

	if not egg then
		return nil
	end

	if egg:IsA("BasePart") then

		return egg

	end

	if egg:IsA("Model") then

		if egg.PrimaryPart then

			return egg.PrimaryPart

		end

		return egg:FindFirstChildWhichIsA(
			"BasePart",
			true
		)

	end

	return nil
end

--------------------------------------------------
-- FIND PROXIMITY PROMPT
--------------------------------------------------

local function findPrompt(egg)

	if not egg then
		return nil
	end

	if egg:IsA("ProximityPrompt") then
		return egg
	end

	for _, object in ipairs(
		egg:GetDescendants()
	) do

		if object:IsA(
			"ProximityPrompt"
		) then

			return object

		end
	end

	return nil
end

