--------------------------------------------------
-- CREATE EGG EFFECT
--------------------------------------------------

local function createEffect(egg)

	local settings =
		eggSettings[egg.Name]

	if not settings then
		return
	end

	local part =
		getEggPart(egg)

	if not part then
		return
	end

	--------------------------------------------------
	-- HIGHLIGHT
	--------------------------------------------------

	local highlight =
		Instance.new("Highlight")

	highlight.Name =
		"EggHighlight"

	highlight.Adornee =
		egg

	highlight.FillColor =
		settings.secondary

	highlight.OutlineColor =
		settings.color

	highlight.FillTransparency =
		0.38

	highlight.OutlineTransparency =
		0

	highlight.DepthMode =
		Enum.HighlightDepthMode.AlwaysOnTop

	highlight.Enabled =
		enabled

	highlight.Parent =
		effectFolder

	--------------------------------------------------
	-- EGG ATTACHMENT
	--------------------------------------------------

	local eggAttachment =
		Instance.new("Attachment")

	eggAttachment.Name =
		"EggAttachment"

	eggAttachment.Parent =
		part

	--------------------------------------------------
	-- PLAYER ATTACHMENT
	--------------------------------------------------

	local character =
		player.Character

	local root =
		character
		and character:FindFirstChild(
			"HumanoidRootPart"
		)

	local playerAttachment =
		Instance.new("Attachment")

	playerAttachment.Name =
		"PlayerAttachment"

	if root then

		playerAttachment.Parent =
			root

	else

		playerAttachment.Parent =
			workspace.Terrain

	end

	--------------------------------------------------
	-- BEAM
	--------------------------------------------------

	local beam =
		Instance.new("Beam")

	beam.Name =
		"EggTracer"

	beam.Attachment0 =
		playerAttachment

	beam.Attachment1 =
		eggAttachment

	--------------------------------------------------
	-- LINE THICKNESS
	--------------------------------------------------

	beam.Width0 =
		0.14

	beam.Width1 =
		0.14

	beam.FaceCamera =
		true

	beam.LightEmission =
		1

	beam.LightInfluence =
		0

	--------------------------------------------------
	-- EGG COLOR GRADIENT
	--------------------------------------------------

	beam.Color =
		ColorSequence.new({

			ColorSequenceKeypoint.new(
				0,
				settings.color
			),

			ColorSequenceKeypoint.new(
				0.5,
				settings.secondary
			),

			ColorSequenceKeypoint.new(
				1,
				settings.color
			)
		})

	beam.Transparency =
		NumberSequence.new(0)

	beam.Enabled =
		enabled

	beam.Parent =
		effectFolder

	--------------------------------------------------
	-- BILLBOARD
	--------------------------------------------------

	local billboard =
		createBillboard(
			egg,
			part,
			settings
		)

	--------------------------------------------------
	-- SAVE
	--------------------------------------------------

	table.insert(
		eggs,
		{
			object = egg,
			part = part,

			highlight = highlight,

			beam = beam,

			billboard = billboard,

			playerAttachment =
				playerAttachment,

			eggAttachment =
				eggAttachment
		}
	)
end

--------------------------------------------------
-- SCAN ALL EGGS
--------------------------------------------------

local function scanEggs()

	local renderedEggs =
		workspace:FindFirstChild(
			"RenderedEggs"
		)

	if not renderedEggs then

		warn(
			"RenderedEggs not found!"
		)

		return
	end

	--------------------------------------------------
	-- DELETE OLD EFFECTS
	--------------------------------------------------

	for _, data in ipairs(eggs) do

		if data.highlight then
			data.highlight:Destroy()
		end

		if data.beam then
			data.beam:Destroy()
		end

		if data.billboard then
			data.billboard:Destroy()
		end

		if data.playerAttachment then
			data.playerAttachment:Destroy()
		end

		if data.eggAttachment then
			data.eggAttachment:Destroy()
		end
	end

	table.clear(eggs)

	--------------------------------------------------
	-- FIND EVERY MATCHING EGG
	--------------------------------------------------

	for _, object in ipairs(
		renderedEggs:GetDescendants()
	) do

		if eggSettings[object.Name] then

			createEffect(
				object
			)
		end
	end

	print(
		"Egg Tracer: found",
		#eggs,
		"eggs"
	)
end

--------------------------------------------------
-- INITIAL SCAN
--------------------------------------------------

