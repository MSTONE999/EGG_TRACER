--------------------------------------------------
-- KEEP TRACERS CONNECTED TO PLAYER
--------------------------------------------------

RunService.RenderStepped:Connect(
	function()

		if not enabled then
			return
		end

		local character =
			player.Character

		if not character then
			return
		end

		local root =
			character:FindFirstChild(
				"HumanoidRootPart"
			)

		if not root then
			return
		end

		--------------------------------------------------
		-- KEEP EVERY PLAYER ATTACHMENT ON PLAYER
		--------------------------------------------------

		for _, data in ipairs(eggs) do

			local attachment =
				data.playerAttachment

			if attachment then

				if attachment.Parent ~= root then

					attachment.Parent =
						root

				end
			end
		end
	end
)

